<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayCasts.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TrayCasts.Views"
    Background="Transparent">

    <Page.Resources>
        <Style
            x:Key="RowItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="ArtTileStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PlayerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <DataTemplate x:Key="EpisodeTemplate" x:DataType="local:EpisodeItem">
            <Grid
                Padding="0,8"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="44"
                    Height="44"
                    VerticalAlignment="Top"
                    Style="{StaticResource ArtTileStyle}"
                    Visibility="{x:Bind ArtVisibility}">
                    <Grid>
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <Image Source="{x:Bind Artwork}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        MaxLines="2"
                        Opacity="{x:Bind TitleOpacity, Mode=OneWay}"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Meta, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <ProgressBar
                        Margin="0,4,0,0"
                        Maximum="1"
                        Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"
                        Value="{x:Bind Progress, Mode=OneWay}" />
                </StackPanel>
                <Grid
                    Grid.Column="2"
                    Width="24"
                    VerticalAlignment="Center">
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE768;"
                        Visibility="{x:Bind PlayGlyphVisibility, Mode=OneWay}" />
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="{x:Bind NowPlayingGlyph, Mode=OneWay}"
                        Visibility="{x:Bind NowPlayingVisibility, Mode=OneWay}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ShowTemplate" x:DataType="local:ShowItem">
            <Grid
                Padding="0,8"
                AutomationProperties.Name="{x:Bind AccessibleName}"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="48"
                    Height="48"
                    Style="{StaticResource ArtTileStyle}">
                    <Grid>
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <Image Source="{x:Bind Artwork}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        MaxLines="2"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Meta}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
                <FontIcon
                    Grid.Column="2"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE76C;" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SearchTemplate" x:DataType="local:SearchItem">
            <Grid
                Padding="0,8"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="44"
                    Height="44"
                    Style="{StaticResource ArtTileStyle}">
                    <Grid>
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <Image Source="{x:Bind Artwork}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        MaxLines="2"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Meta}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
                <Grid
                    Grid.Column="2"
                    Width="24"
                    VerticalAlignment="Center">
                    <ProgressRing
                        Width="16"
                        Height="16"
                        IsActive="{x:Bind IsBusy, Mode=OneWay}" />
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="{x:Bind StateGlyph, Mode=OneWay}"
                        Visibility="{x:Bind StateGlyphVisibility, Mode=OneWay}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="12,12,12,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                AutomationProperties.Name="Back"
                Click="BackButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Back"
                Visibility="Collapsed">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Tray Casts"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <Button
                x:Name="AddButton"
                Grid.Column="2"
                AutomationProperties.Name="Add a podcast"
                Click="AddButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Add a podcast">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
            </Button>
            <Button
                x:Name="RefreshButton"
                Grid.Column="3"
                AutomationProperties.Name="Check for new episodes"
                Click="RefreshButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Check for new episodes">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
            <Button
                Grid.Column="4"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  Problems; the last good content stays visible underneath  -->
        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Warning" />

        <!--  Browse: latest episodes and followed shows  -->
        <Grid
            x:Name="BrowsePanel"
            Grid.Row="2"
            RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <SelectorBar x:Name="BrowseTabs" SelectionChanged="BrowseTabs_SelectionChanged">
                <SelectorBarItem
                    x:Name="LatestTab"
                    IsSelected="True"
                    Text="Latest" />
                <SelectorBarItem x:Name="ShowsTab" Text="Shows" />
            </SelectorBar>
            <ListView
                x:Name="LatestList"
                Grid.Row="1"
                AutomationProperties.Name="Latest episodes"
                ContextRequested="EpisodeList_ContextRequested"
                IsItemClickEnabled="True"
                ItemClick="EpisodeList_ItemClick"
                ItemContainerStyle="{StaticResource RowItemStyle}"
                ItemTemplate="{StaticResource EpisodeTemplate}"
                SelectionMode="None" />
            <ListView
                x:Name="ShowsList"
                Grid.Row="1"
                AutomationProperties.Name="Shows"
                IsItemClickEnabled="True"
                ItemClick="ShowsList_ItemClick"
                ItemContainerStyle="{StaticResource RowItemStyle}"
                ItemTemplate="{StaticResource ShowTemplate}"
                SelectionMode="None"
                Visibility="Collapsed" />
            <StackPanel
                x:Name="EmptyPanel"
                Grid.Row="1"
                MaxWidth="280"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="32"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE8D6;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="No shows yet" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Search for a podcast by name, or paste its RSS feed address."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Click="AddButton_Click"
                    Content="Find a podcast"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!--  One show's episodes  -->
        <Grid
            x:Name="ShowPanel"
            Grid.Row="2"
            RowSpacing="8"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="8,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="56"
                    Height="56"
                    Style="{StaticResource ArtTileStyle}">
                    <Grid>
                        <FontIcon
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <Image x:Name="ShowArt" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        x:Name="ShowAuthorText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        x:Name="ShowCountText"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <Button
                    x:Name="UnfollowButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Unfollow"
                    Style="{StaticResource FlyoutIconButtonStyle}"
                    ToolTipService.ToolTip="Unfollow">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    <Button.Flyout>
                        <Flyout x:Name="UnfollowFlyout" Placement="BottomEdgeAlignedRight">
                            <StackPanel MaxWidth="240" Spacing="12">
                                <TextBlock
                                    x:Name="UnfollowPrompt"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Its episodes and your progress in them will be removed."
                                    TextWrapping="Wrap" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Click="ConfirmUnfollow_Click"
                                    Content="Unfollow"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <ListView
                x:Name="ShowEpisodesList"
                Grid.Row="1"
                AutomationProperties.Name="Episodes"
                ContextRequested="EpisodeList_ContextRequested"
                IsItemClickEnabled="True"
                ItemClick="EpisodeList_ItemClick"
                ItemContainerStyle="{StaticResource RowItemStyle}"
                ItemTemplate="{StaticResource EpisodeTemplate}"
                SelectionMode="None" />
        </Grid>

        <!--  Add: search or paste a feed address  -->
        <Grid
            x:Name="AddPanel"
            Grid.Row="2"
            RowSpacing="8"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox
                x:Name="SearchBox"
                Margin="4,0"
                AutomationProperties.Name="Search podcasts or paste a feed address"
                KeyDown="SearchBox_KeyDown"
                PlaceholderText="Search podcasts or paste a feed address"
                TextChanged="SearchBox_TextChanged" />
            <Grid Grid.Row="1" Margin="8,0">
                <TextBlock
                    x:Name="SearchStatusText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Results come from the Apple Podcasts directory."
                    TextWrapping="Wrap" />
                <ProgressRing
                    x:Name="SearchRing"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Right"
                    IsActive="False" />
            </Grid>
            <ListView
                x:Name="SearchList"
                Grid.Row="2"
                AutomationProperties.Name="Search results"
                IsItemClickEnabled="True"
                ItemClick="SearchList_ItemClick"
                ItemContainerStyle="{StaticResource RowItemStyle}"
                ItemTemplate="{StaticResource SearchTemplate}"
                SelectionMode="None" />
        </Grid>

        <!--  Now playing  -->
        <Border
            x:Name="NowPlayingCard"
            Grid.Row="3"
            Padding="12,10,12,6"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="40"
                        Height="40"
                        Style="{StaticResource ArtTileStyle}">
                        <Grid>
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE8D6;" />
                            <Image x:Name="NowPlayingArt" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="NowPlayingTitle"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            x:Name="NowPlayingShow"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </Grid>
                <TextBlock
                    x:Name="PlaybackErrorText"
                    Margin="0,6,0,0"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <Slider
                    x:Name="PositionSlider"
                    Margin="0,2,0,-6"
                    AutomationProperties.Name="Position"
                    IsThumbToolTipEnabled="False"
                    Minimum="0"
                    StepFrequency="1"
                    ValueChanged="PositionSlider_ValueChanged" />
                <Grid>
                    <TextBlock
                        x:Name="ElapsedText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="0:00" />
                    <TextBlock
                        x:Name="RemainingText"
                        HorizontalAlignment="Right"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="SpeedButton"
                        MinWidth="48"
                        Height="32"
                        Padding="8,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Playback speed"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="SpeedButton_Click"
                        ToolTipService.ToolTip="Playback speed">
                        <TextBlock
                            x:Name="SpeedText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="1×" />
                    </Button>
                    <Button
                        x:Name="SkipBackButton"
                        Grid.Column="1"
                        Click="SkipBackButton_Click"
                        Style="{StaticResource PlayerButtonStyle}">
                        <FontIcon FontSize="16" Glyph="&#xEB9E;" />
                    </Button>
                    <Button
                        x:Name="PlayPauseButton"
                        Grid.Column="2"
                        Margin="8,0"
                        Click="PlayPauseButton_Click"
                        CornerRadius="20"
                        Style="{StaticResource AccentButtonStyle}"
                        Width="40"
                        Height="40"
                        Padding="0">
                        <FontIcon
                            x:Name="PlayPauseIcon"
                            FontSize="16"
                            Glyph="&#xE768;" />
                    </Button>
                    <Button
                        x:Name="SkipForwardButton"
                        Grid.Column="3"
                        Click="SkipForwardButton_Click"
                        Style="{StaticResource PlayerButtonStyle}">
                        <FontIcon FontSize="16" Glyph="&#xEB9D;" />
                    </Button>
                    <ProgressRing
                        x:Name="BufferingRing"
                        Grid.Column="4"
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Loading audio"
                        IsActive="False" />
                </Grid>
            </StackPanel>
        </Border>

        <!--  Footer  -->
        <Grid Grid.Row="4" Margin="4,0">
            <TextBlock
                x:Name="UpdatedText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <ProgressRing
                x:Name="LoadingRing"
                Width="16"
                Height="16"
                HorizontalAlignment="Right"
                IsActive="False" />
        </Grid>
    </Grid>
</Page>
