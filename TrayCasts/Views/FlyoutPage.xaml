<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayCasts.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrayCasts.Controls"
    xmlns:local="using:TrayCasts.Views"
    Background="Transparent">

    <Page.Resources>
        <x:Double x:Key="NowPlayingArtMax">280</x:Double>

        <Style
            x:Key="RowItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="ArtTileStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PlayerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <DataTemplate x:Key="EpisodeTemplate" x:DataType="local:EpisodeItem">
            <Grid
                Padding="0,8"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="44"
                    Height="44"
                    VerticalAlignment="Top"
                    Style="{StaticResource ArtTileStyle}"
                    Visibility="{x:Bind ArtVisibility}">
                    <Grid>
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <Image Source="{x:Bind Artwork}" Stretch="Uniform" />
                    </Grid>
                </Border>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        MaxLines="2"
                        Opacity="{x:Bind TitleOpacity, Mode=OneWay}"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Meta, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <ProgressBar
                        Margin="0,4,0,0"
                        Maximum="1"
                        Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"
                        Value="{x:Bind Progress, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <!--  Only for a show that isn't followed: add or remove just this episode  -->
                    <Button
                        AutomationProperties.AccessibilityView="Raw"
                        Click="EpisodeSaveButton_Click"
                        IsTabStop="False"
                        Style="{StaticResource FlyoutIconButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="{x:Bind SaveLabel, Mode=OneWay}"
                        Visibility="{x:Bind SaveVisibility}">
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="{x:Bind SaveGlyph, Mode=OneWay}" />
                    </Button>
                    <Grid Width="24" VerticalAlignment="Center">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE768;"
                            Visibility="{x:Bind PlayGlyphVisibility, Mode=OneWay}" />
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="{x:Bind NowPlayingGlyph, Mode=OneWay}"
                            Visibility="{x:Bind NowPlayingVisibility, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ShowTemplate" x:DataType="local:ShowItem">
            <Grid
                Padding="0,8"
                AutomationProperties.Name="{x:Bind AccessibleName}"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="48"
                    Height="48"
                    Style="{StaticResource ArtTileStyle}">
                    <Grid>
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <Image Source="{x:Bind Artwork}" Stretch="Uniform" />
                    </Grid>
                </Border>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        MaxLines="2"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Meta}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
                <FontIcon
                    Grid.Column="2"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE76C;" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SearchTemplate" x:DataType="local:SearchItem">
            <Grid
                Padding="0,8"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="44"
                    Height="44"
                    Style="{StaticResource ArtTileStyle}">
                    <Grid>
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <Image Source="{x:Bind Artwork}" Stretch="Uniform" />
                    </Grid>
                </Border>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        MaxLines="2"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Meta}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Click="SearchFollowButton_Click"
                    IsTabStop="False"
                    Style="{StaticResource FlyoutIconButtonStyle}"
                    Tag="{x:Bind}">
                    <Grid>
                        <ProgressRing
                            Width="18"
                            Height="18"
                            IsActive="{x:Bind IsBusy, Mode=OneWay}" />
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="{x:Bind StateGlyph, Mode=OneWay}"
                            Visibility="{x:Bind StateGlyphVisibility, Mode=OneWay}" />
                    </Grid>
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="12,12,12,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                AutomationProperties.Name="Back"
                Click="BackButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Back"
                Visibility="Collapsed">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Tray Casts"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <Button
                x:Name="AddButton"
                Grid.Column="2"
                AutomationProperties.Name="Add a podcast"
                Click="AddButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Add a podcast">
                <FontIcon FontSize="18" Glyph="&#xE710;" />
            </Button>
            <Button
                x:Name="RefreshButton"
                Grid.Column="3"
                AutomationProperties.Name="Check for new episodes"
                Click="RefreshButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Check for new episodes">
                <Grid>
                    <FontIcon
                        x:Name="RefreshIcon"
                        FontSize="16"
                        Glyph="&#xE72C;" />
                    <ProgressRing
                        x:Name="LoadingRing"
                        Width="14"
                        Height="14"
                        AutomationProperties.Name="Checking for new episodes"
                        IsActive="False" />
                </Grid>
            </Button>
            <Button
                Grid.Column="4"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="16" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  Problems; the last good content stays visible underneath  -->
        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Warning" />

        <!--  Browse: latest episodes and followed shows  -->
        <Grid
            x:Name="BrowsePanel"
            Grid.Row="2"
            RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <SelectorBar x:Name="BrowseTabs" SelectionChanged="BrowseTabs_SelectionChanged">
                <SelectorBarItem
                    x:Name="LatestTab"
                    IsSelected="True"
                    Text="Latest" />
                <SelectorBarItem x:Name="ShowsTab" Text="Shows" />
            </SelectorBar>
            <ListView
                x:Name="LatestList"
                Grid.Row="1"
                AutomationProperties.Name="Latest episodes"
                ContextRequested="EpisodeList_ContextRequested"
                IsItemClickEnabled="True"
                ItemClick="EpisodeList_ItemClick"
                ItemContainerStyle="{StaticResource RowItemStyle}"
                ItemTemplate="{StaticResource EpisodeTemplate}"
                SelectionMode="None" />
            <ListView
                x:Name="ShowsList"
                Grid.Row="1"
                AutomationProperties.Name="Shows"
                IsItemClickEnabled="True"
                ItemClick="ShowsList_ItemClick"
                ItemContainerStyle="{StaticResource RowItemStyle}"
                ItemTemplate="{StaticResource ShowTemplate}"
                SelectionMode="None"
                Visibility="Collapsed" />
            <StackPanel
                x:Name="EmptyPanel"
                Grid.Row="1"
                MaxWidth="280"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="32"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE8D6;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="No shows yet" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Search for a podcast by name, or paste its RSS feed address."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Click="AddButton_Click"
                    Content="Find a podcast"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!--  One show's episodes  -->
        <Grid
            x:Name="ShowPanel"
            Grid.Row="2"
            RowSpacing="8"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="8,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="56"
                    Height="56"
                    Style="{StaticResource ArtTileStyle}">
                    <Grid>
                        <FontIcon
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <Image x:Name="ShowArt" Stretch="Uniform" />
                    </Grid>
                </Border>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        x:Name="ShowAuthorText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        x:Name="ShowCountText"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <!--  A show that isn't followed yet: follow it whole, or add single episodes below  -->
                <Button
                    x:Name="FollowButton"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    Click="FollowButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Follow" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="ShowOptionsButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Episode order and limit"
                    Style="{StaticResource FlyoutIconButtonStyle}"
                    ToolTipService.ToolTip="Episode order and limit">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                    <Button.Flyout>
                        <Flyout x:Name="ShowOptionsFlyout" Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="260" Spacing="12">
                                <RadioButtons
                                    x:Name="OrderRadios"
                                    Header="Listen"
                                    SelectionChanged="ShowOptions_Changed">
                                    <x:String>Newest first</x:String>
                                    <x:String>Oldest first</x:String>
                                    <x:String>Newest, then catch up</x:String>
                                </RadioButtons>
                                <TextBlock
                                    x:Name="OrderHintText"
                                    Margin="0,-4,0,0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <ComboBox
                                    x:Name="LimitBox"
                                    HorizontalAlignment="Stretch"
                                    Header="Episodes in Latest"
                                    SelectionChanged="ShowOptions_Changed" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="UnfollowButton"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Unfollow"
                    Style="{StaticResource FlyoutIconButtonStyle}"
                    ToolTipService.ToolTip="Unfollow">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    <Button.Flyout>
                        <Flyout x:Name="UnfollowFlyout" Placement="BottomEdgeAlignedRight">
                            <StackPanel MaxWidth="240" Spacing="12">
                                <TextBlock
                                    x:Name="UnfollowPrompt"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Its episodes and your progress in them will be removed."
                                    TextWrapping="Wrap" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Click="ConfirmUnfollow_Click"
                                    Content="Unfollow"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <ListView
                x:Name="ShowEpisodesList"
                Grid.Row="1"
                AutomationProperties.Name="Episodes"
                ContextRequested="EpisodeList_ContextRequested"
                IsItemClickEnabled="True"
                ItemClick="EpisodeList_ItemClick"
                ItemContainerStyle="{StaticResource RowItemStyle}"
                ItemTemplate="{StaticResource EpisodeTemplate}"
                SelectionMode="None" />
        </Grid>

        <!--  Add: search or paste a feed address  -->
        <Grid
            x:Name="AddPanel"
            Grid.Row="2"
            RowSpacing="8"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox
                x:Name="SearchBox"
                Margin="4,0"
                AutomationProperties.Name="Search podcasts or paste a feed address"
                KeyDown="SearchBox_KeyDown"
                PlaceholderText="Search podcasts or paste a feed address"
                TextChanged="SearchBox_TextChanged" />
            <Grid Grid.Row="1" Margin="8,0">
                <TextBlock
                    x:Name="SearchStatusText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Results come from the Apple Podcasts directory."
                    TextWrapping="Wrap" />
                <ProgressRing
                    x:Name="SearchRing"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Right"
                    IsActive="False" />
            </Grid>
            <ListView
                x:Name="SearchList"
                Grid.Row="2"
                AutomationProperties.Name="Search results"
                IsItemClickEnabled="True"
                ItemClick="SearchList_ItemClick"
                ItemContainerStyle="{StaticResource RowItemStyle}"
                ItemTemplate="{StaticResource SearchTemplate}"
                SelectionMode="None" />
        </Grid>

        <!--
            The player's card surface, drawn apart from the card so it can grow: bottom-aligned at the card's
            height around the mini player, filling the whole content area on the full page. In between, it stays
            full size and a clip moves its top edge (see the PlayerSurface class).
        -->
        <Border
            x:Name="PlayerCardSurface"
            Grid.Row="2"
            Grid.RowSpan="2"
            VerticalAlignment="Bottom"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed" />

        <!--
            Now playing, full page: big art and the episode's details, on the player surface; the card keeps the controls.
            It spans the card's row, with a bottom margin set to the card's height less its header, so it is laid
            out the same with the header or without it: a drag can open it without anything changing size.
        -->
        <Grid
            x:Name="NowPlayingPanel"
            Grid.Row="2"
            Grid.RowSpan="2"
            Padding="16,16,16,4"
            RowSpacing="16"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  Scales the square down when the flyout is short, never up past full size  -->
            <Viewbox
                x:Name="FullArtHost"
                MaxWidth="{StaticResource NowPlayingArtMax}"
                MaxHeight="{StaticResource NowPlayingArtMax}"
                ManipulationCompleted="ArtDrag_ManipulationCompleted"
                ManipulationDelta="ArtDrag_ManipulationDelta"
                ManipulationMode="TranslateY"
                ManipulationStarted="FullArt_ManipulationStarted"
                Stretch="Uniform">
                <Border
                    x:Name="FullArtTile"
                    Width="{StaticResource NowPlayingArtMax}"
                    Height="{StaticResource NowPlayingArtMax}"
                    CornerRadius="8"
                    Style="{StaticResource ArtTileStyle}">
                    <Grid>
                        <FontIcon
                            FontSize="64"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <Image
                            x:Name="FullArt"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="Uniform" />
                    </Grid>
                </Border>
            </Viewbox>
            <StackPanel
                x:Name="FullDetails"
                Grid.Row="1"
                Spacing="4">
                <controls:MarqueeLabel
                    x:Name="FullTitle"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    TextAlignment="Center" />
                <HyperlinkButton
                    x:Name="FullShowLink"
                    Padding="4,2"
                    HorizontalAlignment="Center"
                    Click="FullShowLink_Click">
                    <controls:MarqueeLabel x:Name="FullShowText" TextAlignment="Center" />
                </HyperlinkButton>
                <TextBlock
                    x:Name="FullMeta"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!--  Now playing  -->
        <Border
            x:Name="NowPlayingCard"
            Grid.Row="3"
            Padding="12,10,12,6"
            Visibility="Collapsed">
            <StackPanel x:Name="NowPlayingCardContent">
                <Button
                    x:Name="NowPlayingHeader"
                    Margin="-6,-4,-6,0"
                    Padding="6,4"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="Open now playing"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="NowPlayingHeader_Click"
                    ManipulationCompleted="ArtDrag_ManipulationCompleted"
                    ManipulationDelta="ArtDrag_ManipulationDelta"
                    ManipulationMode="TranslateY"
                    ManipulationStarted="NowPlayingHeader_ManipulationStarted"
                    ToolTipService.ToolTip="Open now playing">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="MiniArtTile"
                            Width="40"
                            Height="40"
                            Style="{StaticResource ArtTileStyle}">
                            <Grid>
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE8D6;" />
                                <Image x:Name="NowPlayingArt" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <controls:MarqueeLabel
                                x:Name="NowPlayingTitle"
                                FontSize="14"
                                FontWeight="SemiBold" />
                            <controls:MarqueeLabel
                                x:Name="NowPlayingShow"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <FontIcon
                            Grid.Column="2"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE70E;" />
                    </Grid>
                </Button>
                <TextBlock
                    x:Name="PlaybackErrorText"
                    Margin="0,6,0,0"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <Slider
                    x:Name="PositionSlider"
                    Margin="0,2,0,-6"
                    AutomationProperties.Name="Position"
                    IsThumbToolTipEnabled="False"
                    Minimum="0"
                    StepFrequency="1"
                    ValueChanged="PositionSlider_ValueChanged" />
                <Grid>
                    <TextBlock
                        x:Name="ElapsedText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="0:00" />
                    <TextBlock
                        x:Name="RemainingText"
                        HorizontalAlignment="Right"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="SpeedButton"
                        MinWidth="48"
                        Height="32"
                        Padding="8,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Playback speed"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="SpeedButton_Click"
                        ToolTipService.ToolTip="Playback speed">
                        <TextBlock
                            x:Name="SpeedText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="1×" />
                    </Button>
                    <Button
                        x:Name="SkipBackButton"
                        Grid.Column="1"
                        Click="SkipBackButton_Click"
                        Style="{StaticResource PlayerButtonStyle}">
                        <FontIcon FontSize="16" Glyph="&#xEB9E;" />
                    </Button>
                    <Button
                        x:Name="PlayPauseButton"
                        Grid.Column="2"
                        Margin="8,0"
                        Click="PlayPauseButton_Click"
                        CornerRadius="20"
                        Style="{StaticResource AccentButtonStyle}"
                        Width="40"
                        Height="40"
                        Padding="0">
                        <FontIcon
                            x:Name="PlayPauseIcon"
                            FontSize="16"
                            Glyph="&#xE768;" />
                    </Button>
                    <Button
                        x:Name="SkipForwardButton"
                        Grid.Column="3"
                        Click="SkipForwardButton_Click"
                        Style="{StaticResource PlayerButtonStyle}">
                        <FontIcon FontSize="16" Glyph="&#xEB9D;" />
                    </Button>
                    <ProgressRing
                        x:Name="BufferingRing"
                        Grid.Column="4"
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Loading audio"
                        IsActive="False" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
