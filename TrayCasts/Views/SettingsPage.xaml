<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayCasts.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Grid">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid Padding="12,12,12,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                AutomationProperties.Name="Back"
                Click="BackButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Settings" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="4,0">
            <StackPanel Spacing="4">
                <TextBlock
                    Margin="0,4,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="General" />
                <Grid ColumnSpacing="12" Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" />
                        <TextBlock
                            x:Name="StartupDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Keep your podcasts a click away after you sign in."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Start with Windows"
                        IsEnabled="False"
                        OffContent=""
                        OnContent=""
                        Toggled="StartupToggle_Toggled" />
                </Grid>
                <Grid ColumnSpacing="12" Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Count new episodes on the tray icon" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Checks your shows once an hour, even with the flyout closed."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="BadgeToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Count new episodes on the tray icon"
                        OffContent=""
                        OnContent=""
                        Toggled="BadgeToggle_Toggled" />
                </Grid>
                <Grid ColumnSpacing="12" Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Show the podcast art on the tray icon" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Replaces the icon with the show's artwork while an episode plays."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="ArtToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Show the podcast art on the tray icon"
                        OffContent=""
                        OnContent=""
                        Toggled="ArtToggle_Toggled" />
                </Grid>

                <TextBlock
                    Margin="0,16,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Playback" />
                <Grid ColumnSpacing="12" Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Play the next episode" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="When one ends, carry on with the show, then with Latest."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="AutoPlayToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Play the next episode"
                        OffContent=""
                        OnContent=""
                        Toggled="AutoPlayToggle_Toggled" />
                </Grid>
                <Grid RowSpacing="8" Style="{StaticResource SettingsCardStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Skip back" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Also the media keys' previous button."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="SkipBackCombo"
                        Grid.Row="1"
                        MinWidth="160"
                        AutomationProperties.Name="Skip back"
                        SelectionChanged="SkipBackCombo_SelectionChanged" />
                </Grid>
                <Grid RowSpacing="8" Style="{StaticResource SettingsCardStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Skip forward" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Also the media keys' next button."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="SkipForwardCombo"
                        Grid.Row="1"
                        MinWidth="160"
                        AutomationProperties.Name="Skip forward"
                        SelectionChanged="SkipForwardCombo_SelectionChanged" />
                </Grid>

                <TextBlock
                    Margin="0,16,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Shows" />
                <Grid RowSpacing="8" Style="{StaticResource SettingsCardStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="OPML" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Bring your shows from another podcast app, or take them with you."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="ImportButton"
                            Click="ImportButton_Click"
                            Content="Import…" />
                        <Button
                            x:Name="ExportButton"
                            Click="ExportButton_Click"
                            Content="Export…" />
                    </StackPanel>
                    <StackPanel
                        x:Name="OpmlStatusPanel"
                        Grid.Row="2"
                        Spacing="4"
                        Visibility="Collapsed">
                        <ProgressBar
                            x:Name="ImportProgress"
                            AutomationProperties.Name="Import progress"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="OpmlStatusText"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            x:Name="VersionText"
            Grid.Row="2"
            Margin="4,0"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>
</Page>
