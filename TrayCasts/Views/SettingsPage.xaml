<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayCasts.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Grid">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid Padding="12,12,12,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                AutomationProperties.Name="Back"
                Click="BackButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Settings" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="4,0">
            <StackPanel Spacing="4">
                <TextBlock
                    Margin="0,4,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="General" />
                <Grid ColumnSpacing="12" Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" />
                        <TextBlock
                            x:Name="StartupDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Keep your podcasts a click away after you sign in."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Start with Windows"
                        IsEnabled="False"
                        OffContent=""
                        OnContent=""
                        Toggled="StartupToggle_Toggled" />
                </Grid>

                <TextBlock
                    Margin="0,16,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Playback" />
                <Grid RowSpacing="8" Style="{StaticResource SettingsCardStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Skip back" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Also the media keys' previous button."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="SkipBackCombo"
                        Grid.Row="1"
                        MinWidth="160"
                        AutomationProperties.Name="Skip back"
                        SelectionChanged="SkipBackCombo_SelectionChanged" />
                </Grid>
                <Grid RowSpacing="8" Style="{StaticResource SettingsCardStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Skip forward" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Also the media keys' next button."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="SkipForwardCombo"
                        Grid.Row="1"
                        MinWidth="160"
                        AutomationProperties.Name="Skip forward"
                        SelectionChanged="SkipForwardCombo_SelectionChanged" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            x:Name="VersionText"
            Grid.Row="2"
            Margin="4,0"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>
</Page>
