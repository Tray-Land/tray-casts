<Project Sdk="Microsoft.NET.Sdk">
  <!--
    UI-free code shared by the app and its tests: podcast models, the RSS parser and feed client,
    podcast search, the saved library, and playback policies. Nothing here may depend on WinUI or
    Windows APIs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TrayCasts</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
</Project>
